model Review {
    id      String @id @default(uuid())
    rating  Int
    comment String

    tenantId String
    tenant   User   @relation(fields: [tenantId], references: [id])

    propertyId String
    properties Properties @relation(fields: [propertyId], references: [id])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("reviews")
}
